{
  "buildCommand": "npx tailwindcss@3 -c tailwind.config.cli.js -i src/input.css -o dist/tailwind.min.css --minify",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "construccionespaimun.ar" }],
      "destination": "https://www.construccionespaimun.ar/:path*",
      "statusCode": 301
    }
  ]
}
